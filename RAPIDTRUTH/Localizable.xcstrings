    "actuatorSafetyRules" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Engine strictly stopped, ignition ON (position II).\n2. Parking brake engaged, gearbox in neutral (P / Neutral).\n3. Keep hands and tools clear of moving parts (fan, belts)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Moteur impérativement coupé, contact mis (position ON/M).\n2. Frein de stationnement serré, boîte au point mort (P / Neutre).\n3. Éloignez les mains et outils des pièces mobiles (ventilateur, courroies)."
          }
        }
      }
    },
